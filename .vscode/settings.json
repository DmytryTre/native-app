{
    // `===``===``===``===``===``===``===``===``===``===``===``===``==`
    // НАСТРОЙКИ ФОРМАТИРОВАНИЯ ДЛЯ TYPESCRIPT
    // `===``===``===``===``===``===``===``===``===``===``===``===``==`
    "[typescript]": {
        // Указываем ESLint как форматтер по умолчанию для TypeScript файлов
        // Это гарантирует, что форматирование будет использовать ESLint правила,
        // а не встроенный форматтер VSCode
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },

    // `===``===``===``===``===``===``===``===``===``===`=
    // ДЕЙСТВИЯ ПРИ СОХРАНЕНИИ ФАЙЛА
    // `===``===``===``===``===``===``===``===``===``===`=
    "editor.codeActionsOnSave": {
        // Включаем автоматическое исправление всех проблем ESLint при сохранении файла
        // "explicit" означает, что действие выполняется только когда явно указано в настройках
        // Это исправляет: стиль кода, отсутствующие точки с запятой, кавычки и т.д.
        "source.fixAll.eslint": "explicit"
    },

    // `===``===``===``===``===``===``===``===``===``===`=
    // НАСТРОЙКИ ESLint
    // `===``===``===``===``===``===``===``===``===``===`=
    
    // Включаем фоновую проверку всей рабочей области (проекта), 
    // чтобы ошибки отображались даже для закрытых файлов
    "eslint.lintTask.enable": true,

    // Указываем, для каких типов файлов запускать ESLint проверку
    "eslint.validate": [
        "javascript",           // Обычные JavaScript файлы (.js)
        "javascriptreact",      // React компоненты на JavaScript (.jsx)
        "typescript",           // Обычные TypeScript файлы (.ts)
        "typescriptreact"       // React компоненты на TypeScript (.tsx)
    ]
}
